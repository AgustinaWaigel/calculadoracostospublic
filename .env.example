# Base de datos Postgres en Supabase (Connect → ORMs → Prisma).
# DATABASE_URL pasa por el pooler (puerto 6543) y la usa la app; DIRECT_URL (5432) la usan las migraciones.
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Ingreso con Supabase Auth, del MISMO proyecto (Project Settings → API Keys).
# La clave es la publicable (anon): no es secreta.
NEXT_PUBLIC_SUPABASE_URL="https://REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# URL pública de la app (se usa para armar los links de los mails de confirmación y recuperación)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional: captcha "no soy un robot" de Cloudflare Turnstile (clave pública / Site Key).
# La clave secreta va en Supabase → Authentication → Attack Protection, no acá.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Suscripciones con Mercado Pago (Tus integraciones → tu aplicación → Credenciales de producción).
# El Access Token es SECRETO: solo en el servidor (sin NEXT_PUBLIC_).
MP_ACCESS_TOKEN=""
# Clave secreta de los Webhooks (Tus integraciones → Webhooks), para validar los avisos.
MP_WEBHOOK_SECRET=""
