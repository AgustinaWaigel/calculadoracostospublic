// Montos y cantidades en Decimal → sin floats. Base: Postgres en Supabase.
// Multiusuario: cada fila es de una cuenta de Supabase Auth (`userId` = auth.users.id).
// Las tablas hijas (recetas, ítems, historial) cuelgan de una fila que ya tiene dueño.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────── Emprendimiento y configuración ─────────

/// Uno por cuenta: el id es el de la cuenta (auth.users.id).
model Business {
  id                   String          @id
  name                 String
  logoUrl              String?
  phone                String?
  email                String?
  instagram            String?
  address              String?
  taxCondition         TaxCondition    @default(MONOTRIBUTO)
  ivaPercent           Decimal         @default(21)
  monthlyUnitsEstimate Int             @default(100)
  /// Cómo se reparten los fijos: por tamaño (unidades normales) o por minutos de trabajo.
  fixedAllocation      FixedAllocation @default(SIZE)
  monthlyHoursEstimate Int             @default(80)
  defaultMarginPercent Decimal         @default(40)
  pricingMode          PricingMode     @default(MARGIN)
  roundTo              Decimal         @default(10)
  quoteValidityDays    Int             @default(7)
  quoteNumberSeq       Int             @default(0)
  updatedAt            DateTime        @updatedAt
}

enum TaxCondition {
  MONOTRIBUTO
  RESPONSABLE_INSCRIPTO
  EXENTO
}

enum FixedAllocation {
  SIZE
  TIME
}

enum PricingMode {
  MARGIN
  MARKUP
}

// ───────── Insumos ─────────

model Supply {
  id             String               @id @default(cuid())
  userId         String
  name           String
  kind           SupplyKind           @default(MATERIAL)
  category       String?
  purchaseUnit   String
  usageUnit      String               @default("unidad")
  packQuantity   Decimal
  packPrice      Decimal
  supplier       String?
  url            String?
  priceUpdatedAt DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  priceHistory   SupplyPriceHistory[]
  usedIn         ProductSupply[]

  @@index([userId])
  @@index([category])
}

enum SupplyKind {
  MATERIAL
  SERVICE
}

model SupplyPriceHistory {
  id           String      @id @default(cuid())
  supplyId     String
  supply       Supply      @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  packPrice    Decimal
  packQuantity Decimal
  source       PriceSource @default(MANUAL)
  usdRate      Decimal?
  recordedAt   DateTime    @default(now())

  @@index([supplyId, recordedAt])
}

enum PriceSource {
  MANUAL
  IMPORT
}

// ───────── Mano de obra ─────────

model LaborProfile {
  id         String         @id @default(cuid())
  userId     String
  name       String
  hourlyRate Decimal
  /// true = lo hace el dueño (es ganancia suya); false = se le paga a otra persona (es costo).
  isOwn      Boolean        @default(true)
  color      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  usedIn     ProductLabor[]

  @@index([userId])
}

model MarketRate {
  id         String   @id @default(cuid())
  userId     String
  label      String
  hourlyRate Decimal
  source     String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ───────── Costos fijos y máquinas ─────────

model FixedCost {
  id            String            @id @default(cuid())
  userId        String
  name          String
  category      FixedCostCategory @default(OTROS)
  monthlyAmount Decimal
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())

  @@index([userId])
}

enum FixedCostCategory {
  ALQUILER
  SERVICIOS
  INTERNET
  IMPUESTOS
  SUSCRIPCIONES
  OTROS
}

model Machine {
  id         String           @id @default(cuid())
  userId     String
  name       String
  price      Decimal
  usefulLife Decimal
  lifeUnit   LifeUnit
  createdAt  DateTime         @default(now())
  usedIn     ProductMachine[]

  @@index([userId])
}

enum LifeUnit {
  UNITS
  HOURS
}

// ───────── Inversiones ─────────

/// Plata que pusiste para arrancar (o para crecer) y lo que vas recuperando de ella.
model InvestmentMovement {
  id          String         @id @default(cuid())
  userId      String
  kind        InvestmentKind
  description String
  amount      Decimal
  date        DateTime
  createdAt   DateTime       @default(now())

  @@index([userId, date])
}

enum InvestmentKind {
  INVESTMENT
  RECOVERY
}

// ───────── Productos (receta / BOM) ─────────

model Product {
  id                String           @id @default(cuid())
  userId            String
  name              String
  description       String?
  category          String?
  batchYield        Decimal          @default(1)
  wastePercent      Decimal          @default(0)
  includeFixedCosts Boolean          @default(true)
  /// Cuántas "unidades normales" equivale este producto al repartir los fijos (chico 0,5 · grande 3).
  fixedWeight       Decimal          @default(1)
  marginPercent     Decimal?
  pricingMode       PricingMode?
  duplicatedFromId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  supplies          ProductSupply[]
  labor             ProductLabor[]
  machines          ProductMachine[]
  quoteItems        QuoteItem[]

  @@index([userId])
}

model ProductSupply {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplyId  String
  supply    Supply  @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  quantity  Decimal

  @@unique([productId, supplyId])
}

model ProductLabor {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId String
  profile   LaborProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  minutes   Decimal

  @@unique([productId, profileId])
}

model ProductMachine {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  usage     Decimal

  @@unique([productId, machineId])
}

// ───────── Canales de venta y volumen ─────────

model SalesChannel {
  id                  String      @id @default(cuid())
  userId              String
  name                String
  type                ChannelType @default(OTHER)
  commissionPercent   Decimal     @default(0)
  fixedFee            Decimal     @default(0)
  shippingCost        Decimal     @default(0)
  paymentFeePercent   Decimal     @default(0)
  installmentsPercent Decimal     @default(0)
  priceAdjustPercent  Decimal     @default(0)
  applyIva            Boolean     @default(true)
  active              Boolean     @default(true)
  sortOrder           Int         @default(0)

  @@index([userId])
}

enum ChannelType {
  DIRECT
  WHOLESALE
  OTHER
}

model VolumeTier {
  id              String  @id @default(cuid())
  userId          String
  minQuantity     Int
  discountPercent Decimal

  @@unique([userId, minQuantity])
}

// ───────── Presupuestos ─────────

model Quote {
  id              String      @id @default(cuid())
  userId          String
  number          Int
  clientName      String
  clientPhone     String?
  clientEmail     String?
  notes           String?
  validUntil      DateTime
  status          QuoteStatus @default(DRAFT)
  /// Cuándo pasó a aceptado (su ganancia cuenta como recupero de la inversión desde esa fecha).
  acceptedAt      DateTime?
  discountPercent Decimal     @default(0)
  /// Descuentos por cantidad propios del presupuesto: [{ minQuantity, discountPercent }]. Se copian de Ajustes al crearlo.
  volumeTiers     Json        @default("[]")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           QuoteItem[]

  @@unique([userId, number])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal
  unitPrice   Decimal
  sortOrder   Int      @default(0)
}

// ───────── Calculadora de impresión ─────────

model PrintInk {
  id          String   @id @default(cuid())
  userId      String
  name        String
  channel     String   @default("OTRO") // K, C, M, Y, LC, LM, OTRO
  color       String   @default("#999999")
  bottlePrice Decimal
  // Páginas A4 al 5% de cobertura que rinde el bote (dato del fabricante).
  yieldPages  Int
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
